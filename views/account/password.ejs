<%- include('../partials/head', { title: 'Đổi mật khẩu' }) %>
<% var errs = locals.errors || {}; %>
<div class="wrap account">
  <%- include('../partials/account-nav') %>
  <div class="measure">
    <h1>Đổi mật khẩu</h1>
    <% if (query.changed === '1') { %><div class="notice ok" role="status">Đã đổi mật khẩu.</div><% } %>
    <form action="/account/password" method="post">
      <input type="hidden" name="csrfToken" value="<%= csrfToken %>">
      <div class="field<%= errs.oldPassword ? ' has-error' : '' %>">
        <label for="oldPassword">Mật khẩu hiện tại</label>
        <input id="oldPassword" type="password" name="oldPassword" autocomplete="current-password" maxlength="200" required>
        <% if (errs.oldPassword) { %><p class="field-error" role="alert"><%= errs.oldPassword %></p><% } %>
      </div>
      <div class="field<%= errs.newPassword ? ' has-error' : '' %>">
        <label for="newPassword">Mật khẩu mới</label>
        <input id="newPassword" type="password" name="newPassword" autocomplete="new-password" maxlength="72" required>
        <span class="hint">Ít nhất 8 ký tự, gồm chữ cái và chữ số.</span>
        <% if (errs.newPassword) { %><p class="field-error" role="alert"><%= errs.newPassword %></p><% } %>
      </div>
      <div class="field<%= errs.confirmPassword ? ' has-error' : '' %>">
        <label for="confirmPassword">Nhập lại mật khẩu mới</label>
        <input id="confirmPassword" type="password" name="confirmPassword" autocomplete="new-password" maxlength="72" required>
        <% if (errs.confirmPassword) { %><p class="field-error" role="alert"><%= errs.confirmPassword %></p><% } %>
      </div>
      <button class="btn" type="submit">Đổi mật khẩu</button>
    </form>
  </div>
</div>
<%- include('../partials/foot') %>
