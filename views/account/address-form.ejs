<%
  var a = locals.address || {};
  var errs = locals.errors || {};
  var editing = Boolean(a.addressId);
  var isDef = a.isDefault === true || a.isDefault === 'on' || a.isDefault === 1;
  var heading = editing ? 'Sửa địa chỉ' : 'Thêm địa chỉ';
%>
<%- include('../partials/head', { title: heading }) %>
<div class="wrap account">
  <%- include('../partials/account-nav') %>
  <div class="measure">
    <h1><%= heading %></h1>
    <form action="<%= editing ? '/account/addresses/' + a.addressId + '/edit' : '/account/addresses/new' %>" method="post">
      <input type="hidden" name="csrfToken" value="<%= csrfToken %>">
      <input type="hidden" name="next" value="<%= locals.next || '' %>">

      <div class="grid-2">
        <div class="field<%= errs.recipientName ? ' has-error' : '' %>">
          <label for="recipientName">Tên người nhận</label>
          <input id="recipientName" type="text" name="recipientName" value="<%= a.recipientName || '' %>" maxlength="100" required>
          <% if (errs.recipientName) { %><p class="field-error" role="alert"><%= errs.recipientName %></p><% } %>
        </div>
        <div class="field<%= errs.phone ? ' has-error' : '' %>">
          <label for="phone">Số điện thoại</label>
          <input id="phone" type="tel" name="phone" value="<%= a.phone || '' %>" maxlength="20" required>
          <% if (errs.phone) { %><p class="field-error" role="alert"><%= errs.phone %></p><% } %>
        </div>
      </div>

      <div class="field<%= errs.province ? ' has-error' : '' %>">
        <label for="province">Tỉnh / thành phố</label>
        <input id="province" type="text" name="province" value="<%= a.province || '' %>" maxlength="100" required>
        <% if (errs.province) { %><p class="field-error" role="alert"><%= errs.province %></p><% } %>
      </div>

      <div class="grid-2">
        <div class="field">
          <label for="district">Quận / huyện</label>
          <input id="district" type="text" name="district" value="<%= a.district || '' %>" maxlength="100" placeholder="Không bắt buộc">
          <span class="hint">Bỏ trống nếu địa phương của bạn không còn cấp này.</span>
        </div>
        <div class="field<%= errs.ward ? ' has-error' : '' %>">
          <label for="ward">Phường / xã</label>
          <input id="ward" type="text" name="ward" value="<%= a.ward || '' %>" maxlength="100" required>
          <% if (errs.ward) { %><p class="field-error" role="alert"><%= errs.ward %></p><% } %>
        </div>
      </div>

      <div class="field<%= errs.street ? ' has-error' : '' %>">
        <label for="street">Số nhà, tên đường</label>
        <input id="street" type="text" name="street" value="<%= a.street || '' %>" maxlength="255" required>
        <% if (errs.street) { %><p class="field-error" role="alert"><%= errs.street %></p><% } %>
      </div>

      <div class="check field">
        <input type="checkbox" id="isDefault" name="isDefault"<%= isDef ? ' checked' : '' %>>
        <label for="isDefault">Đặt làm địa chỉ mặc định</label>
      </div>

      <div class="form-actions">
        <button class="btn" type="submit">Lưu địa chỉ</button>
        <a class="btn btn-outline" href="<%= locals.next || '/account/addresses' %>">Hủy</a>
      </div>
    </form>
  </div>
</div>
<%- include('../partials/foot') %>
