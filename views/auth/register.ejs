<%- include('../partials/head', { title: 'Đăng ký tài khoản' }) %>
<% var errs = locals.errors || {}; var f = locals.fields || {}; %>
<div class="wrap auth narrow">
  <h1>Đăng ký tài khoản</h1>
  <form action="/register" method="post">
    <input type="hidden" name="csrfToken" value="<%= csrfToken %>">

    <div class="field<%= errs.fullName ? ' has-error' : '' %>">
      <label for="fullName">Họ và tên</label>
      <input id="fullName" type="text" name="fullName" value="<%= f.fullName || '' %>" autocomplete="name" maxlength="100" required>
      <% if (errs.fullName) { %><p class="field-error" role="alert"><%= errs.fullName %></p><% } %>
    </div>

    <div class="field<%= errs.email ? ' has-error' : '' %>">
      <label for="email">Email</label>
      <input id="email" type="email" name="email" value="<%= f.email || '' %>" autocomplete="email" maxlength="254" required>
      <% if (errs.email) { %><p class="field-error" role="alert"><%= errs.email %></p><% } %>
    </div>

    <div class="grid-2">
      <div class="field<%= errs.phone ? ' has-error' : '' %>">
        <label for="phone">Số điện thoại</label>
        <input id="phone" type="tel" name="phone" value="<%= f.phone || '' %>" autocomplete="tel" maxlength="20" placeholder="Không bắt buộc">
        <% if (errs.phone) { %><p class="field-error" role="alert"><%= errs.phone %></p><% } %>
      </div>
      <div class="field<%= errs.dateOfBirth ? ' has-error' : '' %>">
        <label for="dateOfBirth">Ngày sinh</label>
        <input id="dateOfBirth" type="date" name="dateOfBirth" value="<%= f.dateOfBirth || '' %>" autocomplete="bday">
        <% if (errs.dateOfBirth) { %><p class="field-error" role="alert"><%= errs.dateOfBirth %></p><% } %>
      </div>
    </div>

    <div class="field<%= errs.password ? ' has-error' : '' %>">
      <label for="password">Mật khẩu</label>
      <input id="password" type="password" name="password" autocomplete="new-password" maxlength="72" required>
      <span class="hint">Ít nhất 8 ký tự, gồm chữ cái và chữ số.</span>
      <% if (errs.password) { %><p class="field-error" role="alert"><%= errs.password %></p><% } %>
    </div>

    <div class="field<%= errs.password2 ? ' has-error' : '' %>">
      <label for="password2">Nhập lại mật khẩu</label>
      <input id="password2" type="password" name="password2" autocomplete="new-password" maxlength="72" required>
      <% if (errs.password2) { %><p class="field-error" role="alert"><%= errs.password2 %></p><% } %>
    </div>

    <%# Hai ô dưới đây KHÔNG đánh dấu sẵn (không có thuộc tính checked). Khách phải tự tích mới đăng ký được. %>
    <div class="field<%= errs.consent ? ' has-error' : '' %>">
      <div class="check">
        <input type="checkbox" id="consentData" name="consentData" required>
        <label for="consentData">Tôi đồng ý để <%= shop.name %> thu thập và xử lý dữ liệu cá nhân của tôi (họ tên, email, số điện thoại, địa chỉ giao hàng) để quản lý tài khoản và xử lý đơn hàng, theo <a href="<%= privacyUrl %>" target="_blank" rel="noopener">Chính sách bảo vệ dữ liệu cá nhân</a>.</label>
      </div>
      <% if (errs.consent) { %><p class="field-error" role="alert"><%= errs.consent %></p><% } %>
    </div>
    <div class="field<%= errs.terms ? ' has-error' : '' %>">
      <div class="check">
        <input type="checkbox" id="agreeTerms" name="agreeTerms" required>
        <label for="agreeTerms">Tôi đã đọc và đồng ý với <a href="<%= termsUrl %>" target="_blank" rel="noopener">Điều khoản sử dụng</a> và <a href="/legal/returns" target="_blank" rel="noopener">Chính sách đổi trả</a>.</label>
      </div>
      <% if (errs.terms) { %><p class="field-error" role="alert"><%= errs.terms %></p><% } %>
    </div>

    <button class="btn btn-block" type="submit">Đăng ký</button>
  </form>
  <p class="auth-alt">Đã có tài khoản? <a href="/login">Đăng nhập</a></p>
</div>
<%- include('../partials/foot') %>
