<%- include('../partials/head') %>
<%
  var blocked = cart.items.some(function (it) { return it.warning; });
  var shipFee = cart.subtotal >= shop.shipping.freeFrom ? 0 : shop.shipping.fee;
%>
<div class="wrap">
  <div class="page-title"><h1>Giỏ hàng</h1></div>

  <% if (added) { %><div class="notice ok" role="status">Đã thêm sản phẩm vào giỏ hàng.</div><% } %>

  <% if (!cart.items.length) { %>
    <div class="empty">
      <h2>Giỏ hàng đang trống</h2>
      <p>Chọn vài món bạn thích rồi quay lại đây.</p>
      <p><a class="btn" href="/products">Xem sản phẩm</a></p>
    </div>
  <% } else { %>
    <div class="cart-layout">
      <ul class="cart-lines">
        <% cart.items.forEach(function (it) { %>
          <li class="cart-line">
            <a class="cart-thumb" href="/products/<%= it.slug %>"><img src="<%= it.image || '/images/placeholder.svg' %>" alt="" width="96" height="128" loading="lazy"></a>
            <div class="cart-info">
              <a class="cart-name" href="/products/<%= it.slug %>"><%= it.name %></a>
              <p class="muted small">Màu <%= it.color %>, size <%= it.size %></p>
              <p class="muted small">SKU <%= it.sku %></p>
              <p class="small"><%= vnd(it.price) %><% if (it.compareAt && it.compareAt > it.price) { %> <s class="compare"><%= vnd(it.compareAt) %></s><% } %></p>
              <% if (it.warning) { %><p class="field-error" role="alert"><%= it.warning %></p><% } %>
            </div>
            <form class="cart-qty" action="/cart/update" method="post">
              <input type="hidden" name="csrfToken" value="<%= csrfToken %>">
              <input type="hidden" name="variantId" value="<%= it.variantId %>">
              <div class="qty" data-qty>
                <button type="button" data-step="-1" aria-label="Giảm số lượng">-</button>
                <input type="number" name="quantity" value="<%= it.quantity %>" min="1" max="<%= Math.max(1, Math.min(shop.limits.maxQtyPerLine, it.stock)) %>" inputmode="numeric" aria-label="Số lượng <%= it.name %>">
                <button type="button" data-step="1" aria-label="Tăng số lượng">+</button>
              </div>
              <button class="btn btn-outline btn-sm" type="submit">Cập nhật</button>
            </form>
            <p class="line-total"><%= vnd(it.lineTotal) %></p>
            <form action="/cart/remove" method="post">
              <input type="hidden" name="csrfToken" value="<%= csrfToken %>">
              <input type="hidden" name="variantId" value="<%= it.variantId %>">
              <button class="btn btn-quiet btn-sm" type="submit" aria-label="Xóa <%= it.name %> khỏi giỏ hàng">Xóa</button>
            </form>
          </li>
        <% }) %>
      </ul>

      <aside class="summary" aria-labelledby="sum-title">
        <h2 id="sum-title">Tóm tắt đơn hàng</h2>
        <dl class="sum">
          <dt>Tạm tính</dt><dd><%= vnd(cart.subtotal) %></dd>
          <dt>Phí giao hàng</dt><dd><%= shipFee === 0 ? 'Miễn phí' : vnd(shipFee) %></dd>
          <dt class="total">Tổng cộng</dt><dd class="total"><%= vnd(cart.subtotal + shipFee) %></dd>
        </dl>
        <p class="muted small">Mã giảm giá nhập ở bước đặt hàng. Tồn kho được kiểm tra lại khi đặt hàng.</p>
        <% if (blocked) { %>
          <div class="notice warn" role="alert">Giỏ hàng có sản phẩm không đủ hàng. Hãy cập nhật hoặc xóa sản phẩm đó trước khi đặt hàng.</div>
          <span class="btn btn-block" aria-disabled="true">Tiến hành đặt hàng</span>
        <% } else { %>
          <a class="btn btn-block" href="/checkout">Tiến hành đặt hàng</a>
        <% } %>
        <p class="center small"><a href="/products">Tiếp tục mua sắm</a></p>
      </aside>
    </div>
  <% } %>
</div>
<%- include('../partials/foot') %>
