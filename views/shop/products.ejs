<%- include('../partials/head') %>
<div class="wrap">
  <nav class="crumbs" aria-label="Đường dẫn">
    <ol>
      <li><a href="/">Trang chủ</a></li>
      <% if (category && category.parentName) { %><li><a href="/category/<%= category.parentSlug %>"><%= category.parentName %></a></li><% } %>
      <li aria-current="page"><%= heading %></li>
    </ol>
  </nav>
  <div class="page-title">
    <h1><%= heading %></h1>
    <p><%= pagination.total %> sản phẩm<% if (category && category.description) { %>. <%= category.description %><% } %></p>
  </div>

  <div class="listing">
    <aside>
      <button class="btn btn-outline btn-sm filters-toggle" type="button" aria-expanded="false" aria-controls="filters">Bộ lọc</button>
      <form id="filters" class="filters filters-collapsible" method="get" action="<%= basePath %>">
        <% if (basePath === '/products' && filters.category) { %><input type="hidden" name="category" value="<%= filters.category %>"><% } %>
        <div class="field">
          <label for="f-q">Từ khóa</label>
          <input id="f-q" type="search" name="q" value="<%= filters.q || '' %>" maxlength="100" placeholder="Tên hoặc mã sản phẩm">
        </div>
        <fieldset>
          <legend>Kích cỡ</legend>
          <div class="filter-checks">
            <% sizes.forEach(function (s) { %>
              <label class="chip"><input type="checkbox" name="size" value="<%= s %>"<% if ((filters.sizes || []).indexOf(s) !== -1) { %> checked<% } %>><span><%= s %></span></label>
            <% }) %>
          </div>
        </fieldset>
        <fieldset>
          <legend>Màu sắc</legend>
          <div class="filter-checks">
            <% facets.colors.forEach(function (c) { %>
              <label class="chip"><input type="checkbox" name="color" value="<%= c.name %>"<% if ((filters.colors || []).indexOf(c.name) !== -1) { %> checked<% } %>><span><svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><circle cx="8" cy="8" r="6.5" fill="<%= c.hex %>" stroke="#bdbab3"/></svg><%= c.name %></span></label>
            <% }) %>
          </div>
        </fieldset>
        <fieldset>
          <legend>Khoảng giá (₫)</legend>
          <div class="price-range">
            <div><label class="sr-only" for="f-min">Giá từ</label><input id="f-min" type="number" name="min" min="0" step="10000" inputmode="numeric" placeholder="Từ" value="<%= filters.minPrice !== undefined ? filters.minPrice : '' %>"></div>
            <div><label class="sr-only" for="f-max">Giá đến</label><input id="f-max" type="number" name="max" min="0" step="10000" inputmode="numeric" placeholder="Đến" value="<%= filters.maxPrice !== undefined ? filters.maxPrice : '' %>"></div>
          </div>
        </fieldset>
        <div class="check field">
          <input id="f-sale" type="checkbox" name="sale" value="1"<% if (filters.onSale) { %> checked<% } %>>
          <label for="f-sale">Chỉ sản phẩm đang giảm giá</label>
        </div>
        <div class="row">
          <button class="btn btn-sm" type="submit">Lọc</button>
          <a class="btn-quiet btn btn-sm" href="<%= basePath %>">Xóa bộ lọc</a>
        </div>
      </form>
    </aside>

    <section aria-label="Danh sách sản phẩm">
      <div class="list-head">
        <p class="muted small">Trang <%= pagination.current %> / <%= pagination.totalPages %></p>
        <div>
          <label for="f-sort">Sắp xếp</label>
          <select id="f-sort" name="sort" form="filters" data-autosubmit>
            <% Object.keys(sorts).forEach(function (k) { %><option value="<%= k %>"<% if (sort === k) { %> selected<% } %>><%= sorts[k] %></option><% }) %>
          </select>
        </div>
      </div>
      <% if (!items.length) { %>
        <div class="empty">
          <h2>Không có sản phẩm phù hợp</h2>
          <p>Thử bỏ bớt bộ lọc hoặc dùng từ khóa khác.</p>
          <p><a class="btn btn-outline" href="<%= basePath %>">Xóa bộ lọc</a></p>
        </div>
      <% } else { %>
        <ul class="grid">
          <% items.forEach(function (p) { %><li><%- include('../partials/product-card', { p: p }) %></li><% }) %>
        </ul>
        <%- include('../partials/pagination', { pagination: pagination, basePath: basePath, qs: baseQuery }) %>
      <% } %>
    </section>
  </div>
</div>
<%- include('../partials/foot') %>
